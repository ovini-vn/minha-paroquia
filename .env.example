# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite .env (já está no .gitignore).
#
# Usamos .env (não .env.local) de propósito: é o único arquivo que tanto o
# Next.js quanto o Prisma CLI leem automaticamente por padrão.

# Role de APLICAÇÃO (restrita, sujeita a Row-Level Security) — é a que o
# Prisma Client usa em runtime, tanto no app quanto nos testes. NÃO é a role
# "dona" que o Neon/Supabase cria por padrão — veja README "Banco de dados"
# para o passo a passo de criar essa role (`app_user`).
DATABASE_URL=

# Role DONA do banco (a que o Neon/Supabase te dá por padrão ao criar o
# projeto) — só usada por `prisma migrate`/`prisma db push`, que precisam de
# DDL. Nunca usada pela aplicação em runtime.
DIRECT_URL=

NODE_ENV=development

# URL base pública da aplicação — usada para montar links absolutos em
# lugares sem acesso à request (ex.: link dentro do e-mail de recuperação de
# senha). Em dev pode ficar em branco (cai em http://localhost:3000). Em
# produção é OBRIGATÓRIA (ex.: https://minhaparoquia.app).
APP_URL=

# E-mail transacional via Resend (resend.com) — usado para o e-mail de
# recuperação de senha. Sem essas variáveis, o app só loga o link no console
# do servidor (comportamento de dev). Em produção são OBRIGATÓRIAS, senão
# ninguém consegue redefinir a senha. Ver README "E-mail transacional".
RESEND_API_KEY=
EMAIL_FROM=

# Notificação fora do app (Web Push). Sem estas chaves, a tela de
# notificações mostra que o recurso não está disponível — o app funciona
# normalmente, só sem o aviso no aparelho.
# Gerar um par novo com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Quem envia, exigido pelo padrão VAPID (mailto: ou https:).
VAPID_SUBJECT=

# Envio de imagem (cartaz de evento) via Vercel Blob. Sem isto o campo de
# arquivo some da tela e sobra só "cole o link" — o app funciona igual.
#
# O store precisa ser PÚBLICO: cartaz tem que abrir no navegador do fiel sem
# login e sem expirar. Um store privado recusa access: "public".
#
# O prefixo CARTAZES_ existe porque a Vercel exige nome distinto ao conectar
# um segundo Blob store no mesmo projeto. Se houver só um, o nome padrão
# BLOB_READ_WRITE_TOKEN também é aceito.
CARTAZES_READ_WRITE_TOKEN=

# Protege o job diário de lembretes (/api/cron/lembretes). A Vercel manda
# este valor no cabeçalho Authorization. SEM ele a rota recusa tudo, de
# propósito — ela dispara notificação para a base inteira.
CRON_SECRET=

# Login social (opcional — sem essas variáveis, os botões "Entrar com
# Google/Facebook" simplesmente redirecionam de volta pro login com um
# aviso, o resto do app funciona normalmente). Callback local:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/facebook/callback
# Ver README para o passo a passo de criar as credenciais no Google Cloud
# Console e no Facebook for Developers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
