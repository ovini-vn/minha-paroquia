# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite .env (já está no .gitignore).
#
# Usamos .env (não .env.local) de propósito: é o único arquivo que tanto o
# Next.js quanto o Prisma CLI leem automaticamente por padrão.

# Role de APLICAÇÃO (restrita, sujeita a Row-Level Security) — é a que o
# Prisma Client usa em runtime, tanto no app quanto nos testes. NÃO é a role
# "dona" que o Neon/Supabase cria por padrão — veja README "Banco de dados"
# para o passo a passo de criar essa role (`app_user`).
DATABASE_URL=

# Role DONA do banco (a que o Neon/Supabase te dá por padrão ao criar o
# projeto) — só usada por `prisma migrate`/`prisma db push`, que precisam de
# DDL. Nunca usada pela aplicação em runtime.
DIRECT_URL=

NODE_ENV=development
