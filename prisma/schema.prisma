// Schema da fundação (fatia 1). Ver docs/FUNDACAO.md para o racional de cada
// decisão. Tabelas tenant-scoped (parish_memberships, invitations) recebem
// políticas de Row-Level Security aplicadas via migration SQL manual — ver
// prisma/migrations/<timestamp>_row_level_security/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL conecta como "app_user" (role restrita, sujeita a RLS) —
  // é a que o Prisma Client usa em runtime. directUrl conecta como o dono
  // do banco (neondb_owner) e só é usada por `prisma migrate`/`db push`,
  // que precisam de DDL. Ver docs/FUNDACAO.md sobre por que isso é
  // necessário: a role padrão do Neon tem BYPASSRLS.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ThemePreference {
  default
  liturgical
}

// Claro vs. escuro. Eixo SEPARADO de ThemePreference (que é sobre o tempo
// litúrgico) — dá para usar a cor do tempo tanto no claro quanto no escuro.
//
// Sem opção "seguir o sistema" de propósito: o padrão é claro, e o escuro é
// escolha explícita. Antes o app seguia prefers-color-scheme e virava escuro
// sozinho, o que ninguém tinha pedido.
enum ColorScheme {
  light
  dark
}

/// Tamanho da letra. Terceiro eixo da aparência, separado do tema e do
/// claro/escuro: numa paróquia há muita gente que enxerga mal, e diminuir a
/// dificuldade de leitura não deveria custar mudar mais nada.
enum FontScale {
  p
  m
  g
}

/// A família da letra. Quarto eixo da aparência, e o mais recente: medindo o
/// contraste e a legibilidade em 29/08/2026 ficou claro que tamanho grande
/// não resolve sozinho — o DESENHO da letra decide se ela se lê com a vista
/// embaçada.
///
/// `inter` continua o padrão: é a letra da identidade, e ninguém que está
/// enxergando bem precisa trocar.
///
/// `atkinson` é a Atkinson Hyperlegible Next, desenhada pelo Braille
/// Institute para baixa visão. Ela diferencia de propósito os caracteres que
/// se confundem — I maiúsculo, l minúsculo e 1 são três desenhos distintos,
/// O e 0 não se misturam — e mantém abertas as aberturas do c, e, a e s, que
/// são as letras que fecham e viram bolinha quando a vista embaça.
///
/// `lexend` é mais larga e espaçada, feita para fluência de leitura. Ajuda
/// quem se perde na linha mais do que quem não enxerga a letra.
enum FontFamily {
  inter
  atkinson
  lexend
}

// Inscrição de um NAVEGADOR/dispositivo para receber notificação fora do
// app (Web Push). Uma pessoa pode ter várias: celular, computador do
// trabalho, etc. — por isso a chave é o endpoint, não o usuário.
//
// O endpoint é uma credencial: quem o tem consegue enviar notificação
// àquele dispositivo. Por isso a tabela leva RLS.
model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // URL do serviço de push do navegador (FCM, Mozilla, WNS...).
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Só para a pessoa reconhecer o aparelho ao desativar.
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  // Opcional: quem entra só via Google/Facebook nunca define uma senha.
  // authenticateUser() trata null como "e-mail ou senha inválidos", nunca
  // revela que a conta é OAuth-only.
  passwordHash    String?         @map("password_hash")
  fullName        String          @map("full_name")
  photoUrl        String?         @map("photo_url")
  phone           String?
  birthDate       DateTime?       @map("birth_date") @db.Date
  isPlatformAdmin Boolean         @default(false) @map("is_platform_admin")
  // Redesign visual: "Tema padrão" vs. "Usar cor do Tempo Litúrgico" — ver
  // src/lib/liturgical-season.ts (fonte única do cálculo) e /eu/aparencia.
  themePreference ThemePreference @default(default) @map("theme_preference")
  colorScheme     ColorScheme     @default(light) @map("color_scheme")
  fontScale       FontScale       @default(p) @map("font_scale")
  fontFamily      FontFamily      @default(inter) @map("font_family")
  // Quando a pessoa passou (ou pulou) as boas-vindas. Nulo = ainda não viu.
  // Guardar a data em vez de um booleano permite saber QUANDO alguém entrou
  // de fato na comunidade, que é diferente de quando criou a conta.
  onboardedAt     DateTime?       @map("onboarded_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  memberships                   ParishMembership[]
  sessions                      Session[]
  passwordResetTokens           PasswordResetToken[]
  invitationsCreated            Invitation[]             @relation("InvitationCreatedBy")
  invitationsUsed               Invitation[]             @relation("InvitationUsedBy")
  priestProfiles                PriestProfile[]
  appointments                  Appointment[]
  volunteerProfiles             VolunteerProfile[]
  serviceInterests              ServiceInterest[]
  pastoralInterests             PastoralGroupInterest[]
  dioceseMemberships            DioceseMembership[]
  provinceMemberships           ProvinceMembership[]
  nationalMembership            NationalMembership?
  pushSubscriptions             WebPushSubscription[]
  massParticipations            MassParticipation[]
  sacraments                    Sacrament[]
  confessionLogs                ConfessionLog[]
  familyMembersResponsible      FamilyMember[]           @relation("FamilyMemberResponsible")
  familyMemberLinkedTo          FamilyMember[]           @relation("FamilyMemberLinked")
  catechismGroupsTaught         CatechismGroup[]
  liturgicalAvailability        LiturgicalAvailability[]
  liturgicalSchedules           LiturgicalSchedule[]
  titheParticipations           TitheParticipation[]     @relation("TitheParticipationUser")
  titheParticipationsRegistered TitheParticipation[]     @relation("TitheParticipationRegisteredBy")
  pixDeContribuicao             PixDeContribuicao[]
  contribuicoes                 Contribuicao[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  prayerRequests                PrayerRequest[]
  familyMemberGuardianOf        FamilyMemberGuardian[]
  permissionOverrides           PermissionOverride[]     @relation("PermissionOverrideUser")
  permissionOverridesGranted    PermissionOverride[]     @relation("PermissionOverrideGrantedBy")
  oauthAccounts                 OAuthAccount[]

  @@map("users")
}

// Província Eclesiástica — o agrupamento canônico de dioceses. Uma
// arquidiocese (sede metropolitana) mais as dioceses sufragâneas, sob um
// Arcebispo Metropolita. No Brasil são ~45.
//
// NÃO é o mesmo recorte que os Regionais da CNBB (18, geográfico/pastoral):
// uma diocese pertence a uma província E a um regional ao mesmo tempo. Só a
// província está modelada aqui — regional entra se/quando for necessário.
//
// Como `dioceses` e `parishes`, é topo de hierarquia e não leva RLS.
model EcclesiasticalProvince {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dioceses    Diocese[]
  memberships ProvinceMembership[]

  @@map("ecclesiastical_provinces")
}

enum ProvinceRole {
  ARCEBISPO_METROPOLITA
  ADMINISTRADOR_PROVINCIAL
}

model ProvinceMembership {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  provinceId String           @map("province_id")
  role       ProvinceRole     @default(ARCEBISPO_METROPOLITA)
  status     MembershipStatus @default(active)
  createdAt  DateTime         @default(now()) @map("created_at")

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  province EcclesiasticalProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([userId, provinceId])
  @@index([provinceId, status])
  @@map("province_memberships")
}

// Escopo NACIONAL. Distinto de users.isPlatformAdmin de propósito: admin da
// plataforma é papel técnico (cria dioceses, administra o sistema); este é
// papel eclesiástico de acompanhamento — vê todas as dioceses, não
// administra a plataforma.
enum NationalRole {
  PRESIDENTE_CNBB
  OBSERVADOR_NACIONAL
}

model NationalMembership {
  id        String           @id @default(uuid())
  userId    String           @unique @map("user_id")
  role      NationalRole     @default(OBSERVADOR_NACIONAL)
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("national_memberships")
}

// Diocese — o nível acima da paróquia. Como `parishes`, é "topo" de
// hierarquia e NÃO leva RLS: não pertence a nenhum tenant, é o que define
// tenants. Ver src/server/modules/dioceses/service.ts para como o acesso do
// bispo é resolvido sem afrouxar o isolamento por paróquia.
model Diocese {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  state         String?
  // Sede metropolitana da província (a arquidiocese). No máximo uma por
  // província, mas não travamos isso no banco: durante a montagem do mapa
  // eclesiástico a paróquia/diocese pode ficar temporariamente sem sede.
  isArchdiocese Boolean  @default(false) @map("is_archdiocese")
  provinceId    String?  @map("province_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  province    EcclesiasticalProvince? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  parishes    Parish[]
  memberships DioceseMembership[]

  @@index([provinceId])
  @@map("dioceses")
}

enum DioceseRole {
  BISPO
  ADMINISTRADOR_DIOCESANO
}

// Vínculo de uma pessoa com uma DIOCESE — separado de ParishMembership de
// propósito: é outro escopo. Bispo não é "papel de paróquia" e não deve
// aparecer nas opções de convite paroquial.
model DioceseMembership {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  dioceseId String           @map("diocese_id")
  role      DioceseRole      @default(BISPO)
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  diocese Diocese @relation(fields: [dioceseId], references: [id], onDelete: Cascade)

  @@unique([userId, dioceseId])
  @@index([dioceseId, status])
  @@map("diocese_memberships")
}

model Parish {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  // Opcional: paróquias cadastradas antes da diocese existir seguem válidas
  // e sem diocese até alguém vinculá-las.
  dioceseId    String?  @map("diocese_id")
  // Usadas pra diferenciar paróquias com o mesmo nome (comum — ex.: várias
  // "Nossa Senhora de Fátima" em cidades diferentes) e pra montar o slug.
  city         String?
  state        String?
  address      String?
  phone        String?
  // Número que recebe mensagem. Separado de `phone` porque a paróquia
  // costuma ter fixo para ligar e celular para WhatsApp, e são diferentes.
  whatsapp     String?
  facebookUrl  String?  @map("facebook_url")
  instagramUrl String?  @map("instagram_url")
  email        String?
  cnpj         String?

  /// Memorial histórico da paróquia, em texto longo, e a foto atual do templo.
  historia        String? @db.Text
  historiaFotoUrl String? @map("historia_foto_url")

  /// Apresentação do pároco. Fica na paróquia, e não no perfil do
  /// sacerdote, porque o pároco nem sempre tem conta no aplicativo — e a
  /// comunidade precisa saber quem é ele de qualquer jeito.
  parocoNome     String? @map("paroco_nome")
  parocoTitulo   String? @map("paroco_titulo")
  parocoHistoria String? @map("paroco_historia") @db.Text
  parocoFotoUrl  String? @map("paroco_foto_url")
  description  String?
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  diocese                 Diocese?                  @relation(fields: [dioceseId], references: [id], onDelete: SetNull)
  memberships             ParishMembership[]
  officeHours             ParishOfficeHours[]
  donationSettings        DonationSettings?
  donationPurposes        DonationPurpose[]
  donationInitiatives     DonationInitiative[]
  notificationDispatches  NotificationDispatch[]
  auditLogs               AuditLog[]
  invitations             Invitation[]
  priestProfiles          PriestProfile[]
  celebrations            Celebration[]
  celebrationSchedules    CelebrationSchedule[]
  events                  Event[]
  avisos                  Aviso[]
  liturgyOfTheDay         LiturgyOfTheDay[]
  pastoralGroups          PastoralGroup[]
  pastoralInterests       PastoralGroupInterest[]
  posts                   Post[]
  priestAvailability      PriestAvailability[]
  appointments            Appointment[]
  volunteerProfiles       VolunteerProfile[]
  serviceOpportunities    ServiceOpportunity[]
  serviceInterests        ServiceInterest[]
  massParticipations      MassParticipation[]
  sacraments              Sacrament[]
  confessionLogs          ConfessionLog[]
  familyMembers           FamilyMember[]
  catechismGroups         CatechismGroup[]
  itinerarios             Itinerario[]
  planosPastorais         PlanoPastoral[]
  contribuicaoFinalidades ContribuicaoFinalidade[]
  pixDeContribuicao       PixDeContribuicao[]
  contribuicoes           Contribuicao[]
  lancamentosDeExtrato    LancamentoDeExtrato[]
  conciliacoesPix         ConciliacaoPix[]
  planoSecoes             PlanoSecao[]
  itinerarioTemas         ItinerarioTema[]
  catechismGroupRites     CatechismGroupRite[]
  catechismEnrollments    CatechismEnrollment[]
  catechismSessions       CatechismSession[]
  catechismAttendance     CatechismAttendance[]
  catechismRites          CatechismRite[]
  liturgicalAvailability  LiturgicalAvailability[]
  liturgicalSchedules     LiturgicalSchedule[]
  titheParticipations     TitheParticipation[]
  notifications           Notification[]
  prayerRequests          PrayerRequest[]
  familyMemberGuardians   FamilyMemberGuardian[]
  permissionOverrides     PermissionOverride[]
  CatechismMassAttendance CatechismMassAttendance[]

  @@map("parishes")
}

// Papéis com escopo de paróquia. ADMIN_PLATFORM NÃO é um Role — é o atributo
// users.isPlatformAdmin, porque não está vinculado a nenhuma comunidade.
model Role {
  id             String  @id @default(uuid())
  code           String  @unique
  name           String
  isParishScoped Boolean @default(true) @map("is_parish_scoped")

  memberships     ParishMembership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid())
  code String @unique

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  active
  // LEGADO. Ninguém entra mais neste estado: quem escolhe a paróquia no
  // onboarding já entra como `active`. O valor continua no enum porque
  // remover valor de enum no Postgres exige recriar o tipo, e não há ganho
  // — nenhuma linha usa e nenhum código escreve.
  pendente
  inactive
}

// unique(user_id) WHERE status IN ('active','pendente') é reforçado por índice parcial
// (migration SQL manual) + checagem na camada de serviço — Prisma não
// suporta unique constraint condicional nativamente.
model ParishMembership {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  parishId     String           @map("parish_id")
  roleId       String           @map("role_id")
  status       MembershipStatus @default(active)
  invitationId String?          @unique @map("invitation_id")
  joinedAt     DateTime         @default(now()) @map("joined_at")
  leftAt       DateTime?        @map("left_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish     Parish      @relation(fields: [parishId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id])
  invitation Invitation? @relation(fields: [invitationId], references: [id])

  @@index([parishId])
  @@index([userId, status])
  @@map("parish_memberships")
}

// Horário de funcionamento da secretaria.
//
// Uma linha por FAIXA, não por dia: paróquia costuma abrir de manhã, fechar
// para o almoço e reabrir à tarde. Guardar "abre" e "fecha" por dia não
// representaria isso, e o app diria "aberto" no horário do almoço.
model ParishOfficeHours {
  id       String @id @default(uuid())
  parishId String @map("parish_id")
  /// 0 = domingo.
  weekday  Int
  /// Minutos desde a meia-noite, horário de Brasília — hora de parede.
  opensAt  Int    @map("opens_at")
  closesAt Int    @map("closes_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId, weekday])
  @@map("parish_office_hours")
}

enum InvitationType {
  link
  qrcode
  individual
}

enum InvitationStatus {
  pending
  used
  expired
  revoked
}

model Invitation {
  id               String           @id @default(uuid())
  parishId         String           @map("parish_id")
  code             String           @unique
  type             InvitationType   @default(link)
  status           InvitationStatus @default(pending)
  maxUses          Int?             @map("max_uses")
  usedCount        Int              @default(0) @map("used_count")
  createdBy        String           @map("created_by")
  expiresAt        DateTime?        @map("expires_at")
  usedBy           String?          @map("used_by")
  usedAt           DateTime?        @map("used_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  // Papel que o vínculo recebe ao aceitar. Null = FIEL (o caso comum — a
  // maioria dos convites é para fiéis). Só PAROCO/SECRETARIA podem criar um
  // convite com outro valor (ex.: SACERDOTE) — ver invitation-actions.ts.
  intendedRoleCode String?          @map("intended_role_code")

  parish           Parish            @relation(fields: [parishId], references: [id], onDelete: Cascade)
  creator          User              @relation("InvitationCreatedBy", fields: [createdBy], references: [id])
  usedByUser       User?             @relation("InvitationUsedBy", fields: [usedBy], references: [id])
  parishMembership ParishMembership?

  @@index([parishId])
  @@map("invitations")
}

// Token opaco (não JWT) hash-armazenado — permite revogação/logout remoto
// sem gerenciar chave de assinatura. Ver src/server/auth/session.ts.
model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum OAuthProvider {
  google
  facebook
}

// Login social — não é tenant-scoped (users não é), sem RLS, mesmo padrão
// de sessions/password_reset_tokens. Vínculo: primeiro tenta achar por
// (provider, providerAccountId); se não achar, tenta achar User existente
// pelo e-mail do provedor (só se o provedor confirma e-mail verificado) e
// linka; senão cria um User novo com passwordHash nulo. Ver
// src/server/auth/oauth.ts.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  email             String
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Criado automaticamente quando um vínculo com papel PAROCO/SACERDOTE é
// criado (seed ou aceite de convite) — ver
// src/server/modules/priests/service.ts. Não existe sem um vínculo
// correspondente; é 1:1 por (userId, parishId).
model PriestProfile {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  parishId     String   @map("parish_id")
  title        String
  bio          String?
  photoUrl     String?  @map("photo_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish               Parish                @relation(fields: [parishId], references: [id], onDelete: Cascade)
  celebrations         Celebration[]
  celebrationSchedules CelebrationSchedule[]
  posts                Post[]
  availability         PriestAvailability[]
  appointments         Appointment[]
  sacraments           Sacrament[]

  @@unique([userId, parishId])
  @@index([parishId])
  @@map("priest_profiles")
}

enum CelebrationType {
  missa
  confissao
  adoracao
  batizado
  casamento
  outro
}

model Celebration {
  id              String          @id @default(uuid())
  parishId        String          @map("parish_id")
  type            CelebrationType @default(missa)
  title           String?
  startsAt        DateTime        @map("starts_at")
  /// A celebração tem DIA, mas não hora.
  ///
  /// Mesmo motivo do evento: o calendário pastoral marca "Tríduo de Santa
  /// Inês" e "Missa na Colina" pelo dia, e a hora se define depois. Sem
  /// isto, a agenda mostrava "00:00" — que é pior do que não dizer, porque
  /// parece informação.
  semHora         Boolean         @default(false) @map("sem_hora")
  location        String?
  priestProfileId String?         @map("priest_profile_id")
  // Preenchido quando a celebração nasceu de uma regra de repetição; nulo
  // quando foi lançada avulsa (a missa extra). SetNull ao apagar a regra:
  // as celebrações que já aconteceram continuam existindo.
  scheduleId      String?         @map("schedule_id")
  // Cancelar UMA ocorrência ("nesse feriado não vai ter") é marcação, nunca
  // exclusão: liturgical_schedules.celebration_id é onDelete Cascade, então
  // apagar a celebração levaria junto a escala de quem ia servir.
  canceledAt      DateTime?       @map("canceled_at")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  parish                   Parish                    @relation(fields: [parishId], references: [id], onDelete: Cascade)
  priestProfile            PriestProfile?            @relation(fields: [priestProfileId], references: [id], onDelete: SetNull)
  schedule                 CelebrationSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  massParticipations       MassParticipation[]
  liturgicalSchedules      LiturgicalSchedule[]
  catechismMassAttendances CatechismMassAttendance[]

  // Impede a geração diária de duplicar a mesma ocorrência. scheduleId nulo
  // não entra na restrição (o Postgres trata NULL como distinto), então
  // celebração avulsa segue livre.
  @@unique([scheduleId, startsAt])
  @@index([parishId, startsAt])
  @@map("celebrations")
}

enum RecurrenceFrequency {
  semanal
  mensal
}

// Regra de repetição: "toda quarta às 19h30", "primeira sexta na capela".
//
// As ocorrências são geradas como Celebration de verdade, não calculadas na
// hora de exibir, porque escala e presença apontam para celebration_id — sem
// linha real não há como escalar ninguém.
model CelebrationSchedule {
  id              String              @id @default(uuid())
  parishId        String              @map("parish_id")
  type            CelebrationType     @default(missa)
  title           String?
  location        String?
  priestProfileId String?             @map("priest_profile_id")
  frequency       RecurrenceFrequency
  /// 0 = domingo.
  weekday         Int
  /// 1..5 quando mensal (5 = ÚLTIMA do mês); nulo quando semanal.
  weekOfMonth     Int?                @map("week_of_month")
  /// Minutos desde a meia-noite, horário de Brasília — hora de parede, não instante.
  timeMinutes     Int                 @map("time_minutes")
  startsOn        DateTime            @map("starts_on") @db.Date
  endsOn          DateTime?           @map("ends_on") @db.Date
  active          Boolean             @default(true)
  createdBy       String              @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")

  parish        Parish         @relation(fields: [parishId], references: [id], onDelete: Cascade)
  priestProfile PriestProfile? @relation(fields: [priestProfileId], references: [id], onDelete: SetNull)
  celebrations  Celebration[]

  @@index([parishId, active])
  @@map("celebration_schedules")
}

enum EventStatus {
  published
  archived
}

model Event {
  id          String      @id @default(uuid())
  parishId    String      @map("parish_id")
  title       String
  description String?
  startsAt    DateTime    @map("starts_at")
  /// O evento tem DIA mas não hora.
  ///
  /// Existe porque o calendário pastoral de uma paróquia é assim: das 286
  /// marcações de 2026, 256 dizem só o dia — "Dia Mundial dos Enfermos",
  /// "Tríduo de Santa Inês", "Assembleia dos Missionários". Guardar isso
  /// como instante obrigaria a inventar um horário, e a agenda mostraria
  /// "00:00" ou uma hora que ninguém marcou. As duas saídas são piores que
  /// dizer a verdade: é no dia 11, e a hora se confirma depois.
  semHora     Boolean     @default(false) @map("sem_hora")
  /// Para dar cor na agenda. Ver `CategoriaDaAgenda`.
  ///
  /// Só no evento: a celebração já diz o que é pelo `type`, e duas fontes
  /// para a mesma pergunta divergiriam no primeiro dia.
  categoria   CategoriaDaAgenda @default(outro)
  location    String?
  // Cartaz do evento. URL, como logoUrl da paróquia e photoUrl do
  // sacerdote — o app não tem upload de arquivo em lugar nenhum.
  imageUrl    String?     @map("image_url")
  status      EventStatus @default(published)
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId, startsAt])
  @@map("events")
}

enum AvisoStatus {
  published
  archived
}

// "Avisos" — comunicados curtos da paróquia (ex.: mudança de horário de
// missa), distintos de Event (compromisso com data/hora) e de Post/Palavra
// do Padre (mensagem do sacerdote). Sempre publicado ao criar, sem estado
// de rascunho — mesmo padrão de Post/Event nesta base.
model Aviso {
  id        String      @id @default(uuid())
  parishId  String      @map("parish_id")
  title     String
  body      String
  status    AvisoStatus @default(published)
  createdBy String      @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId, createdAt])
  @@map("avisos")
}

// Leituras do dia publicadas pela própria paróquia. Guardamos só as
// REFERÊNCIAS (ex.: "Mt 20, 1-16") e a reflexão autoral do pároco — nunca o
// texto bíblico, que vem de traduções licenciadas. Ver
// src/server/modules/liturgia/daily-service.ts.
model LiturgyOfTheDay {
  id              String   @id @default(uuid())
  parishId        String   @map("parish_id")
  // Dia a que se refere, sem hora (uma publicação por paróquia por dia).
  date            DateTime @db.Date
  gospelReference String   @map("gospel_reference")
  gospelTitle     String?  @map("gospel_title")
  firstReading    String?  @map("first_reading")
  psalm           String?
  secondReading   String?  @map("second_reading")
  // Reflexão do pároco: conteúdo autoral da paróquia, esse sim pode ir na íntegra.
  reflection      String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([parishId, date])
  @@index([parishId, date])
  @@map("liturgy_of_the_day")
}

enum PostMediaType {
  texto
  audio
  video
}

// "Palavra do Padre". Sem infraestrutura de upload ainda (decisão de infra
// maior, adiada) — áudio/vídeo são link externo (mediaUrl) em vez de
// arquivo hospedado por nós. Segmentação por grupo (seção 12 do PRD) fica
// para quando pastorais existirem; por ora todo post é público na paróquia.
model Post {
  id              String        @id @default(uuid())
  parishId        String        @map("parish_id")
  /// NULO quando quem publicou não é clero — a secretaria ou o administrador
  /// levando a palavra do pároco à comunidade. A assinatura, nesse caso, vem
  /// do pároco cadastrado na paróquia (ver parishes.paroco_nome).
  priestProfileId String?       @map("priest_profile_id")
  mediaType       PostMediaType @default(texto)
  /// Como a mensagem se chama, quando quem publica quis dar um nome.
  ///
  /// OPCIONAL de propósito. A Palavra do Padre é escrita quase sempre do
  /// celular, muitas vezes minutos antes da missa; exigir um título faria
  /// alguém digitar "Mensagem" todo dia, que é pior do que não ter.
  ///
  /// Existe porque a NOTIFICAÇÃO precisa dizer qual mensagem chegou. Sem
  /// isto, o aviso de um vídeo é sempre a mesma frase — a passagem aparece
  /// só na imagem do vídeo, que é pixel e não dado nosso —, e a paróquia
  /// que publica o Evangelho todo dia empilha avisos idênticos. Foi o que
  /// aconteceu em produção: nove seguidos, nenhum dizendo qual era.
  titulo          String?
  contentText     String?       @map("content_text")
  mediaUrl        String?       @map("media_url")
  /// Quem publicou.
  ///
  /// Era o único modelo do app sem isto, e a falta aparecia na hora de
  /// permitir a edição: sem autor registrado não há como dizer "só quem
  /// escreveu pode mexer". Quando o autor é clero, `priestProfileId` já
  /// respondia; quando é a secretaria publicando em nome do pároco, não
  /// respondia ninguém.
  ///
  /// Opcional porque as publicações anteriores a esta coluna não têm
  /// resposta — inclusive as que entraram pelo importador do calendário.
  /// Nelas, só quem administra a paróquia pode mexer.
  createdBy       String?       @map("created_by")
  publishedAt     DateTime      @default(now()) @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  parish        Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)
  priestProfile PriestProfile? @relation(fields: [priestProfileId], references: [id], onDelete: Cascade)

  @@index([parishId, publishedAt])
  @@map("posts")
}

enum AvailabilityType {
  atendimento
  confissao
}

// Janela semanal recorrente ("toda quarta das 14h às 17h"), não uma data
// concreta — os horários reais são calculados em
// src/server/modules/appointments/service.ts (getAvailableSlots).
// startTime/endTime como string "HH:mm": mais simples que modelar
// recorrência com DateTime, e suficiente para este escopo.
model PriestAvailability {
  id              String           @id @default(uuid())
  parishId        String           @map("parish_id")
  priestProfileId String           @map("priest_profile_id")
  weekday         Int // 0 = domingo ... 6 = sábado
  startTime       String           @map("start_time")
  endTime         String           @map("end_time")
  type            AvailabilityType @default(atendimento)
  slotMinutes     Int              @default(30) @map("slot_minutes")
  createdAt       DateTime         @default(now()) @map("created_at")

  parish        Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)
  priestProfile PriestProfile  @relation(fields: [priestProfileId], references: [id], onDelete: Cascade)

  @@index([parishId, priestProfileId])
  @@map("priest_availability")
}

enum AppointmentCategory {
  confissao
  direcao_espiritual
  conversa
  questao_familiar
  sacramento
  outro
}

enum AppointmentStatus {
  solicitado
  confirmado
  cancelado
  concluido
}

// REGRA CRÍTICA (PRD seção 15/35): nenhum campo de texto livre aqui — nem
// descrição do motivo, nem conteúdo de confissão. Categoria é o único
// contexto armazenado, e é um enum fechado.
model Appointment {
  id              String              @id @default(uuid())
  parishId        String              @map("parish_id")
  priestProfileId String              @map("priest_profile_id")
  fielUserId      String              @map("fiel_user_id")
  category        AppointmentCategory
  scheduledAt     DateTime            @map("scheduled_at")
  status          AppointmentStatus   @default(solicitado)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  parish        Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)
  priestProfile PriestProfile  @relation(fields: [priestProfileId], references: [id], onDelete: Cascade)
  fiel          User          @relation(fields: [fielUserId], references: [id], onDelete: Cascade)

  @@index([parishId, priestProfileId, scheduledAt])
  @@index([fielUserId])
  @@map("appointments")
}

// Formulário "Eu Posso Ajudar" (PRD seção 18) — um por (userId, parishId),
// reenviar atualiza (upsert). Áreas/talentos como string[] em vez de tabelas
// de lookup: são só tags de auto-declaração, não precisam de FK.
model VolunteerProfile {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  parishId         String   @map("parish_id")
  hasTime          Boolean  @default(false) @map("has_time")
  timeAreas        String[] @map("time_areas")
  hasTalent        Boolean  @default(false) @map("has_talent")
  talents          String[]
  wantsToServe     Boolean  @default(false) @map("wants_to_serve")
  serviceAreas     String[] @map("service_areas")
  availabilityNote String?  @map("availability_note")
  freeText         String?  @map("free_text")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([userId, parishId])
  @@index([parishId])
  @@map("volunteer_profiles")
}

enum OpportunityStatus {
  aberta
  encerrada
}

model ServiceOpportunity {
  id          String            @id @default(uuid())
  parishId    String            @map("parish_id")
  title       String
  description String?
  startsAt    DateTime?         @map("starts_at")
  status      OpportunityStatus @default(aberta)
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  parish    Parish            @relation(fields: [parishId], references: [id], onDelete: Cascade)
  interests ServiceInterest[]

  @@index([parishId, status])
  @@map("service_opportunities")
}

enum PastoralGroupStatus {
  ativa
  inativa
}

// Pastorais e grupos da paróquia (Catequese, Liturgia, Ministros, Coral...).
// Diferente de ServiceOpportunity, que é pontual ("preciso de gente pra
// festa"): uma pastoral é permanente e tem coordenador, horário e local.
model PastoralGroup {
  id          String              @id @default(uuid())
  parishId    String              @map("parish_id")
  name        String
  description String?
  // Coordenador como texto: nem todo coordenador tem conta no app, e
  // travar o cadastro nisso impediria a paróquia de listar suas pastorais.
  leaderName  String?             @map("leader_name")
  meetsWhen   String?             @map("meets_when")
  meetsWhere  String?             @map("meets_where")
  status      PastoralGroupStatus @default(ativa)
  createdBy   String              @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  parish    Parish                  @relation(fields: [parishId], references: [id], onDelete: Cascade)
  interests PastoralGroupInterest[]

  @@index([parishId, status])
  @@map("pastoral_groups")
}

// Mesma regra do ServiceInterest (PRD seção 21): manifestar interesse NÃO
// inscreve ninguém — só avisa o coordenador. Entrar na pastoral continua
// sendo uma conversa entre pessoas.
model PastoralGroupInterest {
  id        String         @id @default(uuid())
  groupId   String         @map("group_id")
  userId    String         @map("user_id")
  parishId  String         @map("parish_id")
  status    InterestStatus @default(manifestado)
  createdAt DateTime       @default(now()) @map("created_at")

  group  PastoralGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([parishId])
  @@map("pastoral_group_interests")
}

enum InterestStatus {
  manifestado
  em_contato
  acolhido
  declinado
}

// PRD seção 21 — REGRA: não é match automático. A criação desta linha só
// notifica o responsável (fica visível pra ele no painel); toda mudança de
// status daqui pra frente é uma ação humana explícita, nunca automática.
model ServiceInterest {
  id            String         @id @default(uuid())
  opportunityId String         @map("opportunity_id")
  userId        String         @map("user_id")
  parishId      String         @map("parish_id")
  status        InterestStatus @default(manifestado)
  createdAt     DateTime       @default(now()) @map("created_at")

  opportunity ServiceOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish      Parish             @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([parishId])
  @@map("service_interests")
}

// Minha Caminhada (PRD seção 23-24). reflectionText é privada por padrão —
// a paróquia só acessa indicador agregado (getReflectionAggregate em
// src/server/modules/caminhada/service.ts), nunca a linha individual.
// celebrationId opcional: nem toda missa que o fiel frequenta tem uma
// Celebration cadastrada pelo admin.
model MassParticipation {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  parishId       String   @map("parish_id")
  celebrationId  String?  @map("celebration_id")
  participatedAt DateTime @map("participated_at") @db.Date
  reflectionText String?  @map("reflection_text")
  createdAt      DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish      Parish       @relation(fields: [parishId], references: [id], onDelete: Cascade)
  celebration Celebration? @relation(fields: [celebrationId], references: [id], onDelete: SetNull)

  @@index([parishId, userId])
  @@index([parishId, participatedAt])
  @@map("mass_participations")
}

enum SacramentType {
  batismo
  primeira_eucaristia
  crisma
  matrimonio
  outro
}

enum SacramentStatus {
  self_reported
  validated
}

// Auto-declarado pelo fiel (status self_reported) — nunca é fonte oficial
// sem validação humana. A tela/ação de validação pela secretaria é P2 (ver
// docs/ARQUITETURA.md); o schema já deixa o campo pronto.
/// Batismo, primeira eucaristia, crisma, casamento.
///
/// Pende de UMA das duas pontas, nunca das duas: de um usuário do app, ou de
/// um membro da família sem conta.
///
/// A segunda existe porque a vida sacramental de quem participa NÃO depende
/// de usar o aplicativo. A criança que faz a Primeira Eucaristia tem sete
/// anos e não tem celular; exigir conta para registrar o sacramento dela
/// seria deixar de fora justamente quem a catequese existe para acompanhar.
///
/// A regra "um e só um" é garantida por CHECK no banco, e não por confiança
/// no código: um registro sem dono, ou com dois, é um registro que ninguém
/// consegue encontrar depois.
model Sacrament {
  id              String          @id @default(uuid())
  /// Quem tem conta no app.
  userId          String?         @map("user_id")
  /// Quem não tem — catequizando, criança, dependente.
  familyMemberId  String?         @map("family_member_id")
  parishId        String          @map("parish_id")
  type            SacramentType
  date            DateTime        @db.Date
  location        String?
  priestProfileId String?         @map("priest_profile_id")
  note            String?
  status          SacramentStatus @default(self_reported)
  validatedBy     String?         @map("validated_by")
  validatedAt     DateTime?       @map("validated_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember  FamilyMember?  @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  parish        Parish         @relation(fields: [parishId], references: [id], onDelete: Cascade)
  priestProfile PriestProfile? @relation(fields: [priestProfileId], references: [id], onDelete: SetNull)

  @@index([parishId, userId])
  @@index([parishId, familyMemberId])
  @@map("sacraments")
}

// REGRA CRÍTICA (PRD seção 15/26/35): só a data. Nunca conteúdo — sem
// campo de texto, sem "motivo", sem nada além de quando aconteceu.
model ConfessionLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  parishId  String   @map("parish_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId, userId])
  @@map("confession_logs")
}

// PRD seção 27 (Família), trazido pra cá porque catequizando normalmente é
// dependente de um fiel, não uma conta própria. Sem tabela "Family"
// separada de propósito — responsibleUserId já diz quem administra o
// perfil. linkedUserId fica pronto pra quando o dependente for "promovido"
// a conta própria (FUNDACAO.md, decisão #2), sem precisar migrar nada.
model FamilyMember {
  id                String    @id @default(uuid())
  parishId          String    @map("parish_id")
  // NULO quando a secretaria cadastrou a pessoa e nenhuma conta do app
  // ainda respondeu por ela — o caso do catequizando cujo pai não usa o
  // aplicativo. Deixa de ser nulo quando alguém é vinculado.
  responsibleUserId String?   @map("responsible_user_id")
  // Preenchido se a própria pessoa vier a ter conta no app.
  linkedUserId      String?   @map("linked_user_id")
  fullName          String    @map("full_name")
  // NULO no cadastro feito pela secretaria: "filho de quem?" não faz
  // sentido quando não há um responsável no app a que se referir.
  relationship      String?
  birthDate         DateTime? @map("birth_date") @db.Date
  // Contato do responsável que NÃO está no app. É o que a secretaria
  // precisa para ligar quando falta alguém na catequese.
  guardianName      String?   @map("guardian_name")
  guardianPhone     String?   @map("guardian_phone")
  createdAt         DateTime  @default(now()) @map("created_at")

  parish      Parish                 @relation(fields: [parishId], references: [id], onDelete: Cascade)
  // SetNull, não Cascade: se a secretaria que cadastrou sair da paróquia, o
  // cadastro do catequizando não pode ir junto.
  responsible User?                  @relation("FamilyMemberResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  linkedUser  User?                  @relation("FamilyMemberLinked", fields: [linkedUserId], references: [id], onDelete: SetNull)
  enrollments CatechismEnrollment[]
  guardians   FamilyMemberGuardian[]
  sacraments  Sacrament[]

  @@index([parishId, responsibleUserId])
  @@index([parishId, fullName])
  @@map("family_members")
}

// P2 (docs/ARQUITETURA.md, seção K): "família com múltiplos vínculos
// simultâneos" — um dependente pode ter mais de um responsável ao mesmo
// tempo (ex.: pai e mãe), cada um enxergando e gerenciando o mesmo
// cadastro. responsibleUserId em FamilyMember continua existindo (quem
// cadastrou originalmente); este é o mecanismo real de acesso — quem cria
// um FamilyMember já entra aqui automaticamente como o primeiro guardião.
model FamilyMemberGuardian {
  id             String   @id @default(uuid())
  parishId       String   @map("parish_id")
  familyMemberId String   @map("family_member_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  parish       Parish       @relation(fields: [parishId], references: [id], onDelete: Cascade)
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyMemberId, userId])
  @@index([parishId])
  @@index([userId])
  @@map("family_member_guardians")
}

/// O plano que uma turma segue: os encontros previstos, na ordem.
///
/// É DA PARÓQUIA e digitado por ela, não embutido no app. O material da
/// catequese muda de arquidiocese para arquidiocese, e um roteiro fixo aqui
/// dentro estaria errado para quase todo mundo. A coordenação escreve o
/// itinerário dela uma vez e reaproveita todo ano.
///
/// É o denominador que faltava. Sem ele, "12 encontros dados" não responde
/// nada — a coordenação pede evolução, e evolução é uma fração.
model Itinerario {
  id          String   @id @default(uuid())
  parishId    String   @map("parish_id")
  nome        String
  descricao   String?
  /// Posição na caminhada: 1º ano da Eucaristia antes do 2º.
  ordem       Int      @default(0)
  /// Itinerário aposentado não some — as turmas antigas continuam
  /// apontando para ele —, apenas deixa de ser oferecido em turma nova.
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  parish Parish            @relation(fields: [parishId], references: [id], onDelete: Cascade)
  temas  ItinerarioTema[]
  grupos CatechismGroup[]

  @@index([parishId])
  @@map("itinerarios")
}

/// Um encontro previsto do itinerário: o tema e o material daquele dia.
///
/// `ordem` NÃO é única de propósito. Reordenar uma lista com posição única
/// exige dança de números para não colidir no meio do caminho, e o custo
/// disso não se paga: empate na ordem resolve pela data de criação.
model ItinerarioTema {
  id           String   @id @default(uuid())
  parishId     String   @map("parish_id")
  itinerarioId String   @map("itinerario_id")
  ordem        Int      @default(0)
  titulo       String
  /// O material previsto para o encontro, como a paróquia o descreve.
  descricao    String?
  createdAt    DateTime @default(now()) @map("created_at")

  parish      Parish             @relation(fields: [parishId], references: [id], onDelete: Cascade)
  itinerario  Itinerario         @relation(fields: [itinerarioId], references: [id], onDelete: Cascade)
  encontros   CatechismSession[]

  @@index([parishId, itinerarioId])
  @@map("itinerario_temas")
}

model CatechismGroup {
  id              String   @id @default(uuid())
  parishId        String   @map("parish_id")
  name            String
  year            Int
  catechistUserId String?  @map("catechist_user_id")
  /// A catequista que ainda NÃO tem conta no app, pelo nome.
  ///
  /// Uma turma tem uma catequista só — mas a paróquia sabe quem é antes de
  /// ela se cadastrar, e travar a turma até isso acontecer deixaria a coluna
  /// vazia justamente na hora de organizar o ano. Quando ela entra no app, a
  /// coordenação troca o nome pela conta e o histórico da turma continua o
  /// mesmo.
  ///
  /// Nunca as duas preenchidas: é CHECK no banco. Duas fontes para o mesmo
  /// nome divergem, e a tela passaria a ter de escolher qual mostrar.
  catechistName   String?  @map("catechist_name")
  /// Opcional: as turmas criadas antes do itinerário existir seguem sem um,
  /// e continuam funcionando — só não têm contra o que medir evolução.
  itinerarioId    String?  @map("itinerario_id")
  createdAt       DateTime @default(now()) @map("created_at")

  parish      Parish                @relation(fields: [parishId], references: [id], onDelete: Cascade)
  itinerario  Itinerario?           @relation(fields: [itinerarioId], references: [id], onDelete: SetNull)
  catechist   User?                 @relation(fields: [catechistUserId], references: [id], onDelete: SetNull)
  enrollments CatechismEnrollment[]
  sessions    CatechismSession[]
  ritos       CatechismGroupRite[]

  @@index([parishId])
  @@map("catechism_groups")
}

// Junção turma <-> dependente, não FK direta — o mesmo dependente pode se
// matricular de novo em outro ano/turma no futuro.
model CatechismEnrollment {
  id               String   @id @default(uuid())
  parishId         String   @map("parish_id")
  catechismGroupId String   @map("catechism_group_id")
  familyMemberId   String   @map("family_member_id")
  enrolledAt       DateTime @default(now()) @map("enrolled_at")

  parish          Parish                    @relation(fields: [parishId], references: [id], onDelete: Cascade)
  group           CatechismGroup            @relation(fields: [catechismGroupId], references: [id], onDelete: Cascade)
  familyMember    FamilyMember              @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  attendances     CatechismAttendance[]
  rites           CatechismRite[]
  massAttendances CatechismMassAttendance[]

  @@unique([catechismGroupId, familyMemberId])
  @@index([parishId])
  @@map("catechism_enrollments")
}

model CatechismSession {
  id               String   @id @default(uuid())
  parishId         String   @map("parish_id")
  catechismGroupId String   @map("catechism_group_id")
  date             DateTime @db.Date
  /// O tema do itinerário que foi dado. Opcional porque nem toda turma
  /// segue um itinerário, e porque o catequista pode ter dado outra coisa.
  itinerarioTemaId String?  @map("itinerario_tema_id")
  /// O que foi dado, em texto. Continua existindo mesmo com o tema
  /// escolhido: serve para o complemento ("fizemos também a visita à
  /// capela") e para quem saiu do roteiro.
  topic            String?
  createdAt        DateTime @default(now()) @map("created_at")

  parish      Parish                @relation(fields: [parishId], references: [id], onDelete: Cascade)
  group       CatechismGroup        @relation(fields: [catechismGroupId], references: [id], onDelete: Cascade)
  tema        ItinerarioTema?       @relation(fields: [itinerarioTemaId], references: [id], onDelete: SetNull)
  attendances CatechismAttendance[]

  @@index([parishId, catechismGroupId])
  @@map("catechism_sessions")
}

// "Catequista pode registrar: Presente / Ausente" (PRD seção 28).
model CatechismAttendance {
  id           String   @id @default(uuid())
  parishId     String   @map("parish_id")
  sessionId    String   @map("session_id")
  enrollmentId String   @map("enrollment_id")
  present      Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  parish     Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  session    CatechismSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment CatechismEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
  @@index([parishId])
  @@map("catechism_attendance")
}

// Presença do CATEQUIZANDO na missa.
//
// Não dá para reaproveitar MassParticipation: aquilo é o fiel registrando a
// própria participação, e catequizando quase nunca tem conta no app. Aqui
// quem lança é o catequista, e o vínculo é com a matrícula.
//
// celebrationId é opcional de propósito: a paróquia pode não ter aquela
// missa cadastrada, e travar a chamada nisso faria o catequista desistir de
// lançar. A data sempre existe; a celebração é um detalhe a mais quando há.
model CatechismMassAttendance {
  id            String   @id @default(uuid())
  parishId      String   @map("parish_id")
  enrollmentId  String   @map("enrollment_id")
  celebrationId String?  @map("celebration_id")
  /// Dia da missa, no calendário — não instante.
  attendedOn    DateTime @map("attended_on") @db.Date
  /// Quem lançou, para a família saber a quem perguntar.
  notedBy       String   @map("noted_by")
  createdAt     DateTime @default(now()) @map("created_at")

  parish      Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  enrollment  CatechismEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  celebration Celebration?        @relation(fields: [celebrationId], references: [id], onDelete: SetNull)

  // Uma presença por dia por catequizando — lançar duas vezes o mesmo
  // domingo não pode inflar o acompanhamento da família.
  @@unique([enrollmentId, attendedOn])
  @@index([parishId, enrollmentId])
  @@map("catechism_mass_attendance")
}

/// Um rito da TURMA: a entrega do Pai-Nosso, a apresentação à comunidade.
///
/// Rito acontece num domingo, para a turma inteira. Antes só existia o
/// registro individual, e marcar a entrega do Credo numa turma de 25 eram 25
/// digitações — cada uma podendo grafar o nome de um jeito, o que fazia a
/// coordenação não conseguir contar nada.
///
/// A participação de cada criança continua existindo (`CatechismRite`), e
/// passa a DERIVAR daqui. Os ritos individuais gravados antes deste modelo
/// não foram migrados de propósito: são registro sacramental válido, e
/// reescrevê-los em massa para arrumar a forma seria arriscar o conteúdo.
model CatechismGroupRite {
  id               String    @id @default(uuid())
  parishId         String    @map("parish_id")
  catechismGroupId String    @map("catechism_group_id")
  nome             String
  scheduledAt      DateTime? @map("scheduled_at") @db.Date
  completedAt      DateTime? @map("completed_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  parish        Parish          @relation(fields: [parishId], references: [id], onDelete: Cascade)
  group         CatechismGroup  @relation(fields: [catechismGroupId], references: [id], onDelete: Cascade)
  participacoes CatechismRite[]

  @@index([parishId, catechismGroupId])
  @@map("catechism_group_rites")
}

model CatechismRite {
  id           String    @id @default(uuid())
  parishId     String    @map("parish_id")
  enrollmentId String    @map("enrollment_id")
  /// De qual rito da turma este registro veio. Nulo nos lançados um a um,
  /// inclusive os anteriores ao rito de turma existir.
  grupoRitoId  String?   @map("grupo_rito_id")
  name         String
  scheduledAt  DateTime? @map("scheduled_at") @db.Date
  completedAt  DateTime? @map("completed_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")

  parish     Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  enrollment CatechismEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  grupoRito  CatechismGroupRite? @relation(fields: [grupoRitoId], references: [id], onDelete: SetNull)

  /// Uma participação por criança por rito da turma — marcar duas vezes o
  /// mesmo rito não pode duplicar o registro.
  @@unique([enrollmentId, grupoRitoId])
  @@index([parishId])
  @@map("catechism_rites")
}

enum LiturgicalRoleType {
  leitor
  salmista
  ministro
  acolhida
  musica
  outro
}

// "Fiel informa disponibilidade" (PRD seção 22) — um por (usuário, função);
// reenviar para a mesma função atualiza em vez de duplicar.
/// O plano pastoral do ano: por que a paróquia faz o que faz.
///
/// Existe porque o calendário responde "quando" e nada responde "por quê".
/// A Assembleia define prioridades, a arquidiocese define eixos, e essas
/// decisões governam o ano inteiro — mas ficavam num PDF que ninguém abre.
///
/// Um por ano, por paróquia. O do ano passado não some quando o novo entra:
/// a caminhada de 2025 é o que ilumina a de 2026, e apagá-la seria perder a
/// única memória de rumo que a comunidade tem.
model PlanoPastoral {
  id          String   @id @default(uuid())
  parishId    String   @map("parish_id")
  ano         Int
  titulo      String
  /// A frase de abertura, quando a paróquia quer uma.
  introducao  String?  @db.Text
  /// Rascunho não aparece para o fiel. O plano se escreve aos poucos, e uma
  /// seção pela metade na tela de quem lê é pior do que nada.
  publicado   Boolean  @default(false)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parish Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)
  secoes PlanoSecao[]

  @@unique([parishId, ano])
  @@index([parishId, publicado])
  @@map("planos_pastorais")
}

/// Um trecho do plano, na ordem em que se lê.
///
/// Deliberadamente genérico: "Prioridades paroquiais", "Eixo 1 · Comunhão" e
/// "O que os grupos levantaram" são seções do mesmo tipo. Modelar cada
/// formato daria uma tabela por arquidiocese — e o plano muda de estrutura
/// de uma para outra, como o itinerário da catequese muda.
model PlanoSecao {
  id        String   @id @default(uuid())
  parishId  String   @map("parish_id")
  planoId   String   @map("plano_id")
  ordem     Int      @default(0)
  /// A tarja acima do título: "PRIORIDADE 1", "EIXO 3". Opcional porque nem
  /// toda seção pertence a uma série.
  rotulo    String?
  titulo    String
  /// Parágrafos separados por linha em branco. É texto, e não HTML, porque
  /// quem escreve é a secretaria da paróquia, não alguém que marca.
  corpo     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  parish Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)
  plano  PlanoPastoral @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@index([parishId, planoId])
  @@map("plano_secoes")
}

/// Como o dinheiro chegou à paróquia.
///
/// Existe porque nem toda contribuição passa pelo Pix: o envelope da
/// Pastoral do Dízimo e a coleta da missa são as formas mais antigas que
/// existem, e uma ferramenta que só enxerga Pix diria que quem contribui há
/// trinta anos não contribui.
enum FormaDeRecebimento {
  /// Pix gerado no app, com identificador — a finalidade é conhecida.
  pix_identificado
  /// Pix caiu na conta sem identificador nosso. Alguém precisa dizer de quem
  /// é e para quê.
  pix_avulso
  dinheiro
  envelope
  transferencia
  outro
}

/// O estado de um Pix de contribuição gerado pelo fiel.
///
/// Nada aqui é fatura: `aguardando` não é dívida, e `expirada` não é calote.
/// É só um código que a pessoa gerou e ainda não usou.
enum EstadoDoPix {
  aguardando
  recebida
  expirada
  descartada
}

/// O que se soube fazer com uma linha do extrato.
enum EstadoDoLancamento {
  sem_correspondencia
  conciliado
  conciliado_a_mao
  ignorado
}

enum TipoDeConciliacao {
  automatica
  manual
}

/// Para onde a contribuição vai: dízimo, doação, coleta, catequese, festa.
///
/// Tabela, e não enum, porque a lista muda de paróquia para paróquia e ao
/// longo do ano — "Reforma do telhado" existe enquanto o telhado está sendo
/// reformado. Mesmo motivo pelo qual o itinerário da catequese é digitável.
model ContribuicaoFinalidade {
  id        String   @id @default(uuid())
  parishId  String   @map("parish_id")
  nome      String
  descricao String?  @db.Text
  /// Chave do catálogo de ícones (ver src/lib/doacao.ts).
  icone     String   @default("igreja")
  /// A finalidade do dízimo é a única que conversa com a Pastoral do Dízimo:
  /// uma contribuição confirmada nela marca a participação do período.
  ehDizimo  Boolean  @default(false) @map("eh_dizimo")
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  parish        Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  pix           PixDeContribuicao[]
  contribuicoes Contribuicao[]
  iniciativas   DonationInitiative[]
  cartoes       DonationPurpose[]

  @@index([parishId, ativa, ordem])
  @@map("contribuicao_finalidades")
}

/// O Pix que o fiel gerou para contribuir — com identificador, para a
/// paróquia saber a que se refere quando o dinheiro cair.
///
/// NÃO é cobrança. Ninguém deve nada: é um código que a pessoa pediu, com a
/// finalidade que ela escolheu e o valor que ela quis. Se nunca for usado,
/// não aconteceu nada.
///
/// O valor é opcional porque o dízimo é assim — cada um dá o quanto pode, e
/// um campo obrigatório transformaria isso noutra coisa.
model PixDeContribuicao {
  id            String      @id @default(uuid())
  parishId      String      @map("parish_id")
  /// Quem gerou. Opcional para o dia em que a secretaria gerar um código de
  /// mesa para a festa da padroeira, sem dono.
  userId        String?     @map("user_id")
  /// Ausente É a doação espontânea.
  ///
  /// Não existe uma linha "Doação espontânea" a cadastrar: ela é o caso em
  /// que a pessoa não quis dizer para quê, e obrigar a paróquia a criar uma
  /// finalidade para representar a ausência de finalidade seria burocracia
  /// no lugar de generosidade.
  finalidadeId  String?     @map("finalidade_id")
  /// Em CENTAVOS, ou nulo para o fiel escolher no aplicativo do banco.
  /// Inteiro de propósito: dinheiro em ponto flutuante perde centavo.
  centavos      Int?
  /// O identificador que viaja no código e volta no extrato — quando o banco
  /// o devolve. Ver docs/PIX.md sobre o que depende do banco.
  identificador String      @unique
  /// O BR Code montado, guardado como foi mostrado ao fiel. Se a chave da
  /// paróquia mudar depois, o código antigo continua sendo o que a pessoa
  /// copiou.
  brcode        String      @db.Text
  estado        EstadoDoPix @default(aguardando)
  expiraEm      DateTime?   @map("expira_em")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  parish       Parish                 @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  finalidade   ContribuicaoFinalidade? @relation(fields: [finalidadeId], references: [id], onDelete: Restrict)
  contribuicao Contribuicao?
  conciliacoes ConciliacaoPix[]

  @@index([parishId, estado, createdAt])
  @@index([parishId, userId])
  @@map("pix_de_contribuicao")
}

/// O dinheiro que de fato chegou.
///
/// Separado do Pix gerado porque as duas coisas não se implicam: um código
/// pode nunca ser usado, e a maior parte do que entra numa paróquia — a
/// coleta, o envelope — nunca teve código nenhum.
///
/// A FINALIDADE NUNCA É ADIVINHADA. Ou vem do Pix identificado, ou alguém
/// digitou. Deduzir "R$ 150 deve ser dízimo" é o erro que faz a tesouraria
/// desconfiar de tudo o que o sistema diz.
model Contribuicao {
  id            String             @id @default(uuid())
  parishId      String             @map("parish_id")
  /// De quem foi. Opcional: coleta da missa não tem nome, e Pix avulso pode
  /// nunca ser identificado.
  userId        String?            @map("user_id")
  /// Ausente é a doação espontânea — ver `PixDeContribuicao.finalidadeId`.
  finalidadeId  String?            @map("finalidade_id")
  centavos      Int
  /// O DIA em que entrou, como no extrato.
  recebidaEm    DateTime           @map("recebida_em") @db.Date
  forma         FormaDeRecebimento
  /// Um Pix de contribuição só pode virar contribuição uma vez.
  pixId         String?            @unique @map("pix_id")
  /// Quem lançou. Nulo quando veio de conciliação automática.
  registradaPor String?            @map("registrada_por")
  observacao    String?            @db.Text
  /// Cancelada não some: some o dinheiro do relatório, fica o registro de
  /// que houve e de que foi desfeito.
  cancelada     Boolean            @default(false)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  parish       Parish                 @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  finalidade   ContribuicaoFinalidade? @relation(fields: [finalidadeId], references: [id], onDelete: Restrict)
  pix          PixDeContribuicao?     @relation(fields: [pixId], references: [id], onDelete: SetNull)
  conciliacoes ConciliacaoPix[]

  @@index([parishId, recebidaEm])
  @@index([parishId, userId, recebidaEm])
  @@index([parishId, finalidadeId, recebidaEm])
  @@map("contribuicoes")
}

/// Uma linha do extrato importado.
///
/// Guarda o texto cru do banco junto com os campos normalizados: quando um
/// formato novo aparecer, dá para reprocessar o que já entrou sem pedir o
/// arquivo de volta.
model LancamentoDeExtrato {
  id            String             @id @default(uuid())
  parishId      String             @map("parish_id")
  ocorreuEm     DateTime           @map("ocorreu_em") @db.Date
  centavos      Int
  descricao     String             @db.Text
  /// O identificador achado na descrição, quando o banco o devolve.
  identificador String?
  /// O identificador do próprio arranjo Pix, quando vem.
  endToEndId    String?            @map("end_to_end_id")
  pagador       String?
  /// A linha como veio, para reprocessar depois sem o arquivo original.
  bruto         String             @db.Text
  /// A impressão digital da linha, para o mesmo lançamento não entrar duas
  /// vezes quando a secretaria importar o arquivo de novo.
  ///
  /// Vem do CONTEÚDO (dia, valor, descrição, id do banco) e não da posição
  /// no arquivo: um extrato reexportado com uma linha a mais no começo
  /// empurra todas as outras, e a posição diria que são todas novas.
  impressao     String
  estado        EstadoDoLancamento @default(sem_correspondencia)
  importadoPor  String             @map("importado_por")
  createdAt     DateTime           @default(now()) @map("created_at")

  parish       Parish           @relation(fields: [parishId], references: [id], onDelete: Cascade)
  conciliacoes ConciliacaoPix[]

  @@unique([parishId, impressao])
  @@index([parishId, estado, ocorreuEm])
  @@map("lancamentos_de_extrato")
}

/// Quem ligou qual lançamento a qual contribuição, quando, e como soube.
///
/// Tabela própria em vez de colunas no lançamento porque a pergunta que a
/// tesouraria faz é "quem disse que este dinheiro é da Maria?" — e a
/// resposta precisa sobreviver a alguém desfazer a ligação.
model ConciliacaoPix {
  id             String            @id @default(uuid())
  parishId       String            @map("parish_id")
  lancamentoId   String            @unique @map("lancamento_id")
  pixId          String?           @map("pix_id")
  contribuicaoId String            @map("contribuicao_id")
  tipo           TipoDeConciliacao
  /// Nulo quando foi automática: não houve pessoa.
  feitaPor       String?           @map("feita_por")
  createdAt      DateTime          @default(now()) @map("created_at")

  parish       Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  lancamento   LancamentoDeExtrato @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  pix          PixDeContribuicao?  @relation(fields: [pixId], references: [id], onDelete: SetNull)
  contribuicao Contribuicao        @relation(fields: [contribuicaoId], references: [id], onDelete: Cascade)

  @@index([parishId, createdAt])
  @@map("conciliacoes_pix")
}

/// O tipo de compromisso, para quem lê a agenda.
///
/// Seis famílias, e não as doze categorias do calendário impresso: a lista
/// existe para dar COR a uma grade de mês, e doze cores numa grade de
/// telefone não se distinguem — viram enfeite.
///
/// O agrupamento é o do fiel, não o da secretaria: quem abre a agenda
/// pergunta "é missa, é reunião, é festa?", e não em que gaveta do plano
/// pastoral aquilo foi arquivado.
enum CategoriaDaAgenda {
  missa
  /// Adoração, novena, tríduo, terço — o que se reza sem ser a missa.
  oracao
  /// Batizado, casamento, crisma, primeira eucaristia.
  sacramento
  /// Formação, curso, reunião de conselho, encontro de coordenação.
  formacao
  /// Pastorais, juventude, catequese, visita, grupo bíblico.
  comunidade
  /// Festa da padroeira, quermesse, gincana, promoção.
  festa
  /// O que não coube — fica na cor neutra, e não numa cor errada.
  outro
}

model LiturgicalAvailability {
  id          String             @id @default(uuid())
  parishId    String             @map("parish_id")
  userId      String             @map("user_id")
  roleType    LiturgicalRoleType @map("role_type")
  weekdayPref Int?               @map("weekday_pref")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType])
  @@index([parishId])
  @@map("liturgical_availability")
}

// "Coordenador monta a escala" / "Fiel recebe sua escala" (PRD seção 22).
// confirmed é o próprio fiel confirmando que vai — ação humana, nunca
// setada automaticamente na criação.
model LiturgicalSchedule {
  id            String             @id @default(uuid())
  parishId      String             @map("parish_id")
  celebrationId String             @map("celebration_id")
  roleType      LiturgicalRoleType @map("role_type")
  userId        String             @map("user_id")
  confirmed     Boolean            @default(false)
  createdAt     DateTime           @default(now()) @map("created_at")

  parish      Parish      @relation(fields: [parishId], references: [id], onDelete: Cascade)
  celebration Celebration @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([celebrationId, roleType, userId])
  @@index([parishId])
  @@index([userId])
  @@map("liturgical_schedules")
}

// Dízimo no P1 (docs/ARQUITETURA.md, ambiguidade #6): registra só a
// PRESENÇA de participação por período ("contribuiu em 2026-08"), nunca
// valor monetário — isso fica para o P2, quando houver gateway de
// pagamento definido. Quem registra é sempre pároco/secretaria (ver
// PERMISSIONS.DIZIMO_MANAGE), nunca o próprio fiel — evita indicador
// inflado por autodeclaração.
model TitheParticipation {
  id           String   @id @default(uuid())
  parishId     String   @map("parish_id")
  userId       String   @map("user_id")
  period       String
  registeredBy String   @map("registered_by")
  createdAt    DateTime @default(now()) @map("created_at")

  parish           Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user             User   @relation("TitheParticipationUser", fields: [userId], references: [id], onDelete: Cascade)
  registeredByUser User   @relation("TitheParticipationRegisteredBy", fields: [registeredBy], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([parishId])
  @@index([parishId, period])
  @@map("tithe_participations")
}

enum NotificationCategory {
  urgente
  pessoal
  pastoral
  espiritual
}

// P1 é só canal in-app (docs/ARQUITETURA.md, seção 0 ambiguidade #9: web
// push + e-mail ficam para quando houver decisão de infraestrutura —
// VAPID/provedor de e-mail —, então nenhum campo "channel" aqui ainda).
model Notification {
  id        String               @id @default(uuid())
  parishId  String               @map("parish_id")
  userId    String               @map("user_id")
  category  NotificationCategory
  title     String
  body      String
  readAt    DateTime?            @map("read_at")
  /// Para onde a notificação leva dentro do app. Guardado aqui porque é o
  /// que permite dar a notificação por lida quando a pessoa abre o conteúdo
  /// no lugar certo, em vez de exigir um segundo toque em "já vi".
  linkPath  String?              @map("link_path")
  createdAt DateTime             @default(now()) @map("created_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parishId])
  @@index([userId, readAt])
  @@index([userId, linkPath])
  @@map("notifications")
}

// Sem parish_id de propósito: preferência é do usuário, não da paróquia
// (mesmo padrão de `users`/`sessions` — não é tenant-scoped, não recebe
// RLS). Ausência de linha para uma categoria == habilitada por padrão.
model NotificationPreference {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

enum PrayerRequestVisibility {
  padre
  comunidade
}

/// Moderação do que vai ao mural. Pedido endereçado ao padre nasce
/// aprovado: ele já é privado, e moderar uma mensagem dirigida ao padre,
/// pelo próprio padre, seria circular.
enum PrayerRequestStatus {
  pendente
  aprovado
  recusado
}

// docs/ARQUITETURA.md, seção "Participação e pedidos de oração". Visibilidade
// "padre" é privada: só pároco/sacerdote enxergam (mesma sensibilidade de
// confissão). "comunidade" é um mural visível a qualquer fiel da paróquia.
// is_anonymous controla só a EXIBIÇÃO do nome — o requesterUserId sempre fica
// gravado, nunca some, para moderação futura.
model PrayerRequest {
  id              String                  @id @default(uuid())
  parishId        String                  @map("parish_id")
  requesterUserId String                  @map("requester_user_id")
  contentText     String                  @map("content_text")
  visibility      PrayerRequestVisibility @default(padre)
  isAnonymous     Boolean                 @default(false) @map("is_anonymous")
  status          PrayerRequestStatus     @default(pendente)
  moderatedBy     String?                 @map("moderated_by")
  moderatedAt     DateTime?               @map("moderated_at")
  createdAt       DateTime                @default(now()) @map("created_at")

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  requester User   @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([parishId, visibility])
  @@map("prayer_requests")
}

// P2 (docs/ARQUITETURA.md, ambiguidade #7 e seção C.2): delegação fina além
// do papel fixo — ex.: "esse coordenador pode editar catequese mas não
// liturgia". granted=true CONCEDE uma permissão que o papel não tem;
// granted=false REVOGA uma que o papel normalmente tem. A permissão
// efetiva de um usuário = permissões do papel, com os overrides aplicados
// por cima (ver src/server/auth/session.ts). Único por (userId,
// permissionCode) porque só existe um vínculo ativo por usuário.
model PermissionOverride {
  id             String   @id @default(uuid())
  parishId       String   @map("parish_id")
  userId         String   @map("user_id")
  permissionCode String   @map("permission_code")
  granted        Boolean
  grantedBy      String   @map("granted_by")
  createdAt      DateTime @default(now()) @map("created_at")

  parish  Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  user    User   @relation("PermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  granter User   @relation("PermissionOverrideGrantedBy", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@unique([userId, permissionCode])
  @@index([parishId])
  @@map("permission_overrides")
}

/// Categoria de uma iniciativa, para o fiel se situar no que a paróquia faz.
enum DonationCategory {
  obras
  evangelizacao
  catequese
  acao_social
  pastoral
  formacao
  outros
}

/// Como o botão "Quero ser dizimista" leva o fiel adiante.
enum DizimoCtaTipo {
  whatsapp
  link
  interno
}

/// Dados de doação da paróquia — uma linha por paróquia.
///
/// Separado de `parishes` porque é informação financeira: fica em tabela
/// própria, com a sua própria política de RLS, e não viaja junto em toda
/// consulta que só queria o nome da paróquia.
///
/// Não guarda nada que movimente dinheiro: sem token de gateway, sem
/// credencial. A chave PIX e o copia-e-cola são os mesmos que a paróquia
/// divulga no mural da igreja.
model DonationSettings {
  id       String @id @default(uuid())
  parishId String @unique @map("parish_id")

  /// Chave PIX e o tipo dela, para o fiel conferir antes de pagar.
  pixKey     String? @map("pix_key")
  pixKeyType String? @map("pix_key_type")
  /// BR Code gerado pelo BANCO da paróquia e colado aqui. Não é montado
  /// por nós de propósito: payload de pagamento errado manda dinheiro para
  /// o lugar errado.
  pixPayload String? @map("pix_payload") @db.Text

  /// Convite da Pastoral do Dízimo. Dízimo não é doação: é compromisso
  /// contínuo, acompanhado pela pastoral — por isso convida, não cobra.
  dizimoAtivo    Boolean        @default(true) @map("dizimo_ativo")
  dizimoTitulo   String?        @map("dizimo_titulo")
  dizimoTexto    String?        @map("dizimo_texto") @db.Text
  dizimoCtaLabel String?        @map("dizimo_cta_label")
  dizimoCtaTipo  DizimoCtaTipo? @map("dizimo_cta_tipo")
  dizimoCtaValor String?        @map("dizimo_cta_valor")

  updatedAt DateTime @updatedAt @map("updated_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@map("donation_settings")
}

/// Card de "Sua doação ajuda": para onde o dinheiro vai, em geral.
model DonationPurpose {
  id          String  @id @default(uuid())
  parishId    String  @map("parish_id")
  title       String
  description String  @db.Text
  /// Chave do catálogo de ícones (ver src/lib/doacao.ts). Guardar o
  /// nome do componente deixaria a tela renderizar o que viesse do banco.
  icon        String  @default("igreja")
  /// Para onde vai o que se contribuir a partir deste cartão.
  ///
  /// Mesma ideia da iniciativa: opcional, e vazio é legítimo. Este cartão
  /// existe para explicar no que a paróquia aplica o que recebe; virar
  /// caminho de contribuição é um acréscimo, não a razão de ele existir.
  finalidadeId String? @map("finalidade_id")
  displayOrder Int    @default(0) @map("display_order")
  active      Boolean @default(true)

  parish     Parish                  @relation(fields: [parishId], references: [id], onDelete: Cascade)
  finalidade ContribuicaoFinalidade? @relation(fields: [finalidadeId], references: [id], onDelete: SetNull)

  @@index([parishId, active, displayOrder])
  @@map("donation_purposes")
}

/// "O que estamos realizando": o que está acontecendo agora na paróquia.
model DonationInitiative {
  id          String           @id @default(uuid())
  parishId    String           @map("parish_id")
  title       String
  description String           @db.Text
  imageUrl    String?          @map("image_url")
  icon        String           @default("obras")
  category    DonationCategory @default(outros)
  /// Para onde vai o que se contribuir por causa desta iniciativa.
  ///
  /// Opcional, e continua opcional de propósito: nem toda iniciativa pede
  /// dinheiro. "A missão nas periferias" é uma coisa que a paróquia FAZ, e
  /// transformá-la automaticamente em pedido mudaria o que a seção é.
  finalidadeId String?         @map("finalidade_id")
  startsOn    DateTime?        @map("starts_on") @db.Date
  endsOn      DateTime?        @map("ends_on") @db.Date
  displayOrder Int             @default(0) @map("display_order")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")

  parish     Parish                  @relation(fields: [parishId], references: [id], onDelete: Cascade)
  finalidade ContribuicaoFinalidade? @relation(fields: [finalidadeId], references: [id], onDelete: SetNull)

  @@index([parishId, active, displayOrder])
  @@map("donation_initiatives")
}

/// Registro do que o robô diário já enviou.
///
/// Sem ele, repetir o job manda tudo de novo — e a Vercel repete quando
/// falha. Receber o mesmo aviso duas vezes é o que faz alguém desligar as
/// notificações, e aí a pessoa deixa de receber também o que importa.
///
/// A `chave` descreve o envio de forma única: "resumo:<paróquia>:<sábado>",
/// "<usuário>:atendimento-<id>:hoje:<data>". Gravar é a própria trava.
model NotificationDispatch {
  id        String   @id @default(uuid())
  parishId  String   @map("parish_id")
  chave     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId, createdAt])
  @@map("notification_dispatches")
}

/// Um versículo da Bíblia, na tradução do Pe. Matos Soares.
///
/// Tabela GLOBAL, sem parish_id e sem RLS: a Escritura é a mesma em toda
/// paróquia, não é dado de ninguém e não há o que isolar. É catálogo, como
/// papéis e permissões — não conteúdo de comunidade.
///
/// A chave é o próprio endereço do versículo (livro, capítulo, número).
/// Não há id artificial porque não faz falta: "joao 3:16" já identifica de
/// forma única e é como o texto é citado no mundo real. De quebra, a chave
/// composta impede duplicar um versículo se a importação rodar duas vezes.
///
/// `book` guarda o SLUG do catálogo em src/lib/bible-books.ts, não o nome
/// que veio da fonte — a fonte usa português europeu ("Deuteronómio",
/// "Livro Primeiro de Samuel") e o app fala português brasileiro.
model BibleVerse {
  book    String
  chapter Int
  number  Int
  text    String

  @@id([book, chapter, number])
  @@index([book, chapter])
  @@map("bible_verses")
}

/// Contador de tentativas por chave, para limitar abuso.
///
/// Tabela GLOBAL, sem parish_id e sem RLS: a proteção vale antes de existir
/// sessão, e portanto antes de existir paróquia. É infraestrutura, como o
/// catálogo de papéis — não conteúdo de comunidade.
///
/// Janela FIXA, não deslizante: uma linha por chave, uma instrução para
/// checar e incrementar. Deslizante seria mais preciso e exigiria guardar
/// cada tentativa; para conter abuso de login, a diferença não paga o custo.
///
/// A chave carrega o que se está limitando: "login:email:...",
/// "login:ip:...", "recuperar:ip:...".
model RateLimit {
  chave        String   @id
  contagem     Int      @default(0)
  janelaExpira DateTime @map("janela_expira")

  @@index([janelaExpira])
  @@map("rate_limits")
}

/// Registro de quem fez o quê, para as operações que dão ou tiram acesso.
///
/// Sem ele não há como responder "quem mudou o papel desta pessoa" nem
/// "quem gerou link de acesso para quem" — perguntas que uma ferramenta com
/// dado sensível precisa saber responder.
///
/// A entrada é gravada NA MESMA TRANSAÇÃO da mudança. Do lado de fora,
/// mais cedo ou mais tarde existiria mudança sem registro — e um log com
/// buracos não serve para responder nada.
///
/// `detalhe` guarda ids e códigos, NUNCA conteúdo. O texto de um pedido de
/// oração ou de um aviso não entra aqui: o log diz que algo foi moderado,
/// não o que estava escrito.
///
/// Não há caminho de edição nem de exclusão no código, de propósito.
model AuditLog {
  id        String   @id @default(uuid())
  parishId  String   @map("parish_id")
  /// Quem executou. Sem relação com User: se a conta for apagada, o registro
  /// do que ela fez precisa sobreviver.
  atorId    String   @map("ator_id")
  /// Código estável, tipo "papel.trocado". O rótulo legível mora no código.
  acao      String
  alvoTipo  String?  @map("alvo_tipo")
  alvoId    String?  @map("alvo_id")
  detalhe   Json?
  createdAt DateTime @default(now()) @map("created_at")

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@index([parishId, createdAt])
  @@map("audit_logs")
}
